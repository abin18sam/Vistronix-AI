# Copy this file to `.env` and fill in your real values.
# Never commit your actual .env file with real API keys.

# Which provider to use: "openai" or "gemini"
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Gemini (only needed if LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-pro

# --- LLM behavior ---
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# --- PDF Parser integration ---
# Path to the sibling vistronix-pdf-extractor project. Used to auto-locate its
# output/parsed_document.json and extracted_images/ folder for the
# POST /understand-latest endpoint. Default assumes both projects sit
# side-by-side in the same parent folder, e.g.:
#   dev/vistronix-pdf-extractor/
#   dev/vistronix-understanding-engine/
# Change this if your layout is different (e.g. on Windows:
# PARSER_PROJECT_DIR=C:/dev/vistronix-pdf-extractor)
PARSER_PROJECT_DIR=../vistronix-pdf-extractor

# Optional direct overrides (normally derived automatically from PARSER_PROJECT_DIR above)
# INPUT_JSON_PATH=../vistronix-pdf-extractor/output/parsed_document.json
# PARSER_IMAGES_DIR=../vistronix-pdf-extractor/extracted_images

# --- This engine's own output ---
OUTPUT_JSON_PATH=output/knowledge_graph.json

# --- Logging ---
LOG_LEVEL=INFO
