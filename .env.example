APP_ENV=development
DATABASE_URL=sqlite:///./storage/vistronix.db
STORAGE_ROOT=./storage
REDIS_URL=redis://localhost:6379/0
QUEUE_MODE=celery
ENABLE_OCR=true
ENABLE_TABLE_EXTRACTION=false
ENABLE_MULTIMEDIA=false
MAX_UPLOAD_BYTES=52428800
LOG_LEVEL=INFO
LLM_PROVIDER=openai
# Set LLM_PROVIDER=mock for offline integration testing without an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
